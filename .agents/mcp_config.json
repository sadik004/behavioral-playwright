{
  "mcpServers": {
    "behavioral-playwright": {
      "command": "python",
      "args": [
        "-m",
        "behavioral_playwright.mcp.server"
      ],
      "cwd": "E:/Bug",
      "env": {
        "PYTHONPATH": "E:/Bug/src"
      }
    },
    "reddit-mcp": {
      "command": "python",
      "args": [
        "-m",
        "reddit_mcp"
      ],
      "cwd": "E:/Bug/Reddit.mcp/src",
      "env": {
        "PYTHONPATH": "E:/Bug/Reddit.mcp/src"
      }
    },
    "n8n-mcp": {
      "command": "python",
      "args": [
        "-m",
        "n8n_mcp",
        "--transport",
        "native-stdio"
      ],
      "cwd": "E:/Bug/n8n.mcp/src",
      "env": {
        "PYTHONPATH": "E:/Bug/n8n.mcp/src",
        "N8N_HOST": "http://localhost:5678",
        "N8N_API_KEY": ""
      }
    }
  }
}
