# --- Python runtime artifacts ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Test / tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Generated data artifacts (framework writes these at runtime) ---
*.db
*.sqlite3
*.ndjson
*.jsonl
*.csv
*.parquet
*.tmp
*.corrupt
*.bak

# --- Logs ---
*.log
logs/

# --- Screenshots / captures ---
screenshots/
*.png
*.jpg
*.jpeg

# --- Secrets / credentials / environment ---
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials*.json
*token*.txt

# --- IDE / OS noise ---
.idea/
.vscode/
.DS_Store
Thumbs.db
